# Copy this file to .env for local development.
# On Hugging Face Spaces, set these as "Secrets" in your Space settings instead.

SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key (not the anon key) — found in Supabase > Project Settings > API.
# Keep this secret! It bypasses Row Level Security, which is why only the backend uses it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SEGMENTATION_MODEL_PATH=models/unet_segmentation.keras
